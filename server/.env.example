# ============================================================
# SERVER (Express) — Rinomina in .env e compila i valori
# Queste variabili NON devono mai essere nel repository!
# ============================================================

# ── Supabase (obbligatorio) ──────────────────────────────────
# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# ⚠ SERVICE_ROLE key: accesso admin totale — mai esposta al frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Stripe (necessario per lo shop) ─────────────────────────
# stripe.com → Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
# stripe.com → Dashboard → Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Server ──────────────────────────────────────────────────
PORT=5001
# URL del frontend (usato per redirect dopo pagamento)
CLIENT_URL=https://www.albasax.com

# ── Admin ───────────────────────────────────────────────────
# Password segreta per le route admin (/api/admin/subscribers, ecc.)
ADMIN_SECRET=cambia_con_una_stringa_casuale_lunga
